rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email.lower() == 'saitrishankb9@gmail.com'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      // Owner cannot modify admin claims or assessment metadata directly
      allow update: if (isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'admin', 
          'verifiedSkills', 
          'assessmentScores', 
          'failedAssessments', 
          'failedAssessmentsFeedback', 
          'integrityTerminations',
          'assessmentStartedAt',
          'assessmentSkill',
          'assessmentVariant',
          'assessmentSeed',
          'assessmentDate'
        ])
      )) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Candidate profile documents
    match /candidates/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Candidates can create profile with draft or pending status, but cannot set admin audit fields
      allow create: if (isOwner(userId) && (
        !request.resource.data.keys().hasAny(['verifiedBy', 'verifiedByUid', 'verifiedByEmail', 'verifiedAt', 'verifiedSkills']) &&
        (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus in ['draft', 'pending'])
      )) || isAdmin();
      // Candidates can update profile (draft or pending) but cannot self-verify or tamper with admin audit fields
      allow update: if (isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verifiedAt', 'verifiedBy', 'verifiedByUid', 'verifiedByEmail', 'verifiedSkills']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus']) || request.resource.data.verificationStatus in ['draft', 'pending'])
      )) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Employer profile documents
    match /employers/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Job postings
    match /jobs/{jobId} {
      allow read: if isAuthenticated() || (resource.data.status == 'published');
      allow create: if isAuthenticated() && (request.resource.data.employerId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.employerId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.employerId == request.auth.uid || isAdmin());
    }

    // Candidate applications for jobs
    match /jobApplications/{appId} {
      allow read: if isAuthenticated() && (
        resource.data.candidateId == request.auth.uid || 
        resource.data.employerId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated() && (request.resource.data.candidateId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (
        resource.data.employerId == request.auth.uid || 
        resource.data.candidateId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // New Skill requests submitted by candidates (read & managed by admin)
    match /newSkillRequests/{docId} {
      allow read, write: if isAdmin();
    }

    // Funnel events — write-only telemetry from client, read-only for admin
    match /funnel_events/{eventId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Contact form inquiries — validated schema for public, read/manage for admin
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 150
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 4000;
      allow read, update, delete: if isAdmin();
    }
  }
}
