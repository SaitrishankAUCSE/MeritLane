"use client";

import React, { useState, useEffect } from "react";
import { Plus, Trash2, AlertCircle, Check, Globe, ExternalLink, ShieldCheck, User, GraduationCap, Code2, Briefcase, FileCode2, LineChart, BadgeCheck, CheckCircle2, Loader2, Save } from "lucide-react";
import { Badge } from "@/components/ui/Badge";
import { Input } from "@/components/ui/Input";
import { Textarea } from "@/components/ui/Textarea";
import { Button } from "@/components/ui/Button";
import { TagInput } from "@/components/ui/TagInput";
import { Autocomplete } from "@/components/ui/Autocomplete";
import { useAuth } from "@/lib/auth/AuthContext";
import { useRouter } from "next/navigation";
import { fetchCandidateProfile, saveCandidateProfile, ProjectEntry, VerificationStatus } from "@/lib/firebase/candidate";
import { logFunnelEvent } from "@/lib/analytics/logEvent";
import Link from "next/link";
import { ProofSignal, EvidenceRail } from "@/components/ui/ProofSignal";
import { ProofTrace } from "@/components/ui/ProofTrace";

// Fake interfaces for UI-only fields
interface ExperienceEntry {
  id: string;
  role: string;
  company: string;
  startDate: string;
  endDate: string;
  description: string;
}

const TABS = [
  { id: "overview", label: "Dossier Overview", icon: User },
  { id: "about", label: "Identity", icon: Globe },
  { id: "education", label: "Academic Record", icon: GraduationCap },
  { id: "skills", label: "Technical Stack", icon: Code2 },
  { id: "projects", label: "Project Evidence", icon: FileCode2 },
  { id: "experience", label: "Experience", icon: Briefcase },
  { id: "assessments", label: "Assessment Signals", icon: LineChart },
];

const ENGINEERING_BRANCHES = [
  "Computer Science and Engineering",
  "Information Technology",
  "Electronics and Communication Engineering",
  "Electrical and Electronics Engineering",
  "Mechanical Engineering",
  "Civil Engineering",
  "Chemical Engineering",
  "Aerospace Engineering",
  "Biotechnology",
  "Artificial Intelligence and Data Science",
  "Cyber Security",
  "Robotics and Automation"
];

const PASSING_YEARS = Array.from({ length: 15 }, (_, i) => (new Date().getFullYear() - 5 + i).toString());

export default function CandidateProfilePage() {
  const { user, role: userRole, loading: authLoading, profileLoading, userProfile } = useAuth();
  const router = useRouter();
  
  const [dataLoading, setDataLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  
  const [activeTab, setActiveTab] = useState("overview");

  // Real Fields
  const [verificationStatus, setVerificationStatus] = useState<VerificationStatus>("draft");
  const [verificationReason, setVerificationReason] = useState<string | null>(null);
  const [name, setName] = useState<string>("");
  const [college, setCollege] = useState<string>("");
  const [branch, setBranch] = useState<string>("");
  const [gradYear, setGradYear] = useState<string>("");
  const [githubUrl, setGithubUrl] = useState<string>("");
  const [resumeUrl, setResumeUrl] = useState<string>("");
  const [skills, setSkills] = useState<string[]>([]);
  const [projects, setProjects] = useState<ProjectEntry[]>([]);
  
  // UI-only Fields (Prototype)
  const [title, setTitle] = useState<string>("");
  const [location, setLocation] = useState<string>("");
  const [summary, setSummary] = useState<string>("");
  const [cgpa, setCgpa] = useState<string>("");
  const [experience, setExperience] = useState<ExperienceEntry[]>([]);

  const [notification, setNotification] = useState<{type: "success" | "error", message: string} | null>(null);

  useEffect(() => {
    if (notification) {
      const timer = setTimeout(() => setNotification(null), 3000);
      return () => clearTimeout(timer);
    }
  }, [notification]);

  useEffect(() => {
    if (!authLoading && user?.email?.toLowerCase() === "saitrishankb9@gmail.com") {
      router.replace("/admin");
    }
  }, [user, authLoading, router]);

  useEffect(() => {
    if (!authLoading && !profileLoading && user && userRole === "candidate") {
      fetchCandidateProfile(user.uid)
        .then((profile) => {
          if (profile) {
            setName(profile.name || "");
            setCollege(profile.college || "");
            setBranch(profile.branch || "");
            setGradYear(profile.gradYear || "");
            setGithubUrl(profile.githubUrl || "");
            setResumeUrl(profile.resumeUrl || "");
            setSkills(profile.skills || []);
            setProjects(profile.projects || []);
            setVerificationStatus(profile.verificationStatus || "draft");
            setVerificationReason(profile.verificationReason || null);
          }
        })
        .catch((error) => console.error("Error fetching profile:", error))
        .finally(() => setDataLoading(false));
    }
  }, [user, userRole, authLoading, profileLoading]);

  // Completion calculation
  const hasBasicInfo = !!(name && college);
  const hasSkills = !!(skills && skills.length > 0);
  const hasGithub = !!(githubUrl);
  const hasProjects = !!(projects && projects.length > 0);
  const hasSummary = !!(summary);
  const hasExperience = !!(experience && experience.length > 0);
  
  let completionScore = 0;
  if (hasBasicInfo) completionScore += 20;
  if (hasSkills) completionScore += 20;
  if (hasGithub) completionScore += 15;
  if (hasProjects) completionScore += 25;
  if (hasSummary) completionScore += 10;
  if (hasExperience) completionScore += 10;

  const handleSave = async (statusOverride?: VerificationStatus) => {
    if (!user) return;
    setSaving(true);
    const targetStatus = statusOverride || verificationStatus;
    
    const timeoutPromise = new Promise((_, reject) => 
      setTimeout(() => reject(new Error("Timeout: Could not connect to Firebase.")), 8000)
    );
    try {
      const savePromise = saveCandidateProfile(user.uid, {
        name,
        email: user.email || "",
        college,
        branch,
        gradYear,
        githubUrl,
        resumeUrl,
        skills,
        projects,
        verificationStatus: targetStatus,
      });
      await Promise.race([savePromise, timeoutPromise]);
      setVerificationStatus(targetStatus);
      
      if (targetStatus === "pending") {
        logFunnelEvent("profile_submitted", { projectCount: projects.length });
        setNotification({ type: "success", message: "Dossier submitted for verification audit!" });
      } else {
        setNotification({ type: "success", message: "Dossier changes saved." });
      }
    } catch (error: any) {
      console.error("Error saving:", error);
      setNotification({ type: "error", message: error.message || "Failed to save dossier." });
    } finally {
      setSaving(false);
    }
  };

  const fetchColleges = async (query: string): Promise<string[]> => {
    if (!query || query.length < 2) return [];
    try {
      const response = await fetch(`/api/colleges?q=${encodeURIComponent(query)}`);
      if (!response.ok) throw new Error("Failed to fetch");
      const data = await response.json();
      return data.results || [];
    } catch (err) {
      return [];
    }
  };

  if (authLoading || (user && profileLoading) || dataLoading) {
    return (
      <div className="flex min-h-[calc(100vh-56px)] items-center justify-center pb-24 pt-12">
        <Loader2 className="h-8 w-8 animate-spin text-outline" />
      </div>
    );
  }

  const isLocked = verificationStatus === "verified";
  const assessmentCount = userProfile?.assessmentScores ? Object.keys(userProfile.assessmentScores).length : 0;

  return (
    <div className="min-h-[calc(100vh-56px)] pb-24 pt-10">
      {notification && (
        <div className={`fixed top-6 right-6 z-50 border px-4 py-3 ${
          notification.type === 'success' ? 'border-border bg-foreground text-background' : 'border-danger/40 text-danger'
        }`}>
          <p className="text-sm font-medium">{notification.message}</p>
        </div>
      )}

      <div className="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 space-y-10">
        
        {/* DOSSIER HEADER */}
        <div className="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 border-b border-border pb-6">
          <div className="flex items-end gap-5">
            <div className="h-20 w-20 bg-surface-low flex items-center justify-center text-2xl font-bold text-outline border border-border shrink-0 overflow-hidden">
              {user?.photoURL ? (
                <img src={user.photoURL} alt={name} className="h-full w-full object-cover" />
              ) : (
                name ? name.charAt(0).toUpperCase() : "U"
              )}
            </div>
            <div className="mb-1">
              <p className="font-label mb-1 text-outline">Technical identity workspace</p>
              <div className="flex items-center gap-3 mb-1">
                <h1 className="font-serif text-3xl font-medium tracking-tight text-foreground">
                  {name || "Engineering Identity"}
                </h1>
                <ProofTrace 
                  status={verificationStatus} 
                  assessmentScores={userProfile?.assessmentScores} 
                  assessmentDate={userProfile?.assessmentDate}
                  candidateName={name}
                  size="sm"
                />
              </div>
              <p className="text-sm font-medium text-muted-foreground">
                {title || "Software Engineer"} {location && `• ${location}`}
              </p>
            </div>
          </div>
          
          <div className="flex items-center gap-3 w-full md:w-auto">
            {isLocked ? (
              <Button variant="outline" disabled className="w-full sm:w-auto" leftIcon={<ShieldCheck className="w-4 h-4"/>}>
                Dossier Verified & Locked
              </Button>
            ) : (
              <>
                <Button variant="outline" onClick={() => handleSave()} loading={saving} className="flex-1 sm:flex-none">
                  <Save className="w-4 h-4 mr-2" /> Save Changes
                </Button>
                {verificationStatus !== "pending" && (
                  <Button variant="primary" onClick={() => handleSave("pending")} loading={saving} disabled={projects.length === 0} className="flex-1 sm:flex-none">
                    Submit for Audit
                  </Button>
                )}
                {verificationStatus === "pending" && (
                  <Button variant="outline" disabled className="flex-1 sm:flex-none bg-amber-50 text-amber-800 border-amber-200">
                    Audit Pending
                  </Button>
                )}
              </>
            )}
          </div>
        </div>

        <div className="flex flex-col lg:flex-row gap-12">
          {/* DOSSIER NAVIGATION */}
          <div className="lg:w-48 shrink-0">
            <nav className="sticky top-20 flex flex-row gap-0.5 overflow-x-auto border-l border-border pb-2 pl-4 lg:flex-col lg:overflow-visible lg:pb-0">
              {TABS.map((tab) => {
                const isActive = activeTab === tab.id;
                return (
                  <button
                    key={tab.id}
                    onClick={() => setActiveTab(tab.id)}
                    className={`relative flex items-center px-3 py-2 text-[13px] font-semibold tracking-wide transition-colors whitespace-nowrap text-left ${
                      isActive 
                        ? "text-foreground" 
                        : "text-muted-foreground hover:text-foreground"
                    }`}
                  >
                    {isActive && (
                      <span className="absolute -left-4 top-0 h-full w-[2px] bg-foreground" />
                    )}
                    <span>{tab.label}</span>
                  </button>
                );
              })}
            </nav>
          </div>

          {/* DOSSIER CONTENT AREA */}
          <div className="flex-1 min-w-0 pb-20">
            
            {/* OVERVIEW TAB */}
            {activeTab === "overview" && (
              <div className="space-y-10 animate-in fade-in slide-in-from-bottom-4 duration-300">
                <section>
                  <h2 className="text-xs font-bold text-foreground uppercase tracking-widest border-b border-border pb-2 mb-6">Dossier Overview</h2>
                  
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
                    <div>
                      <h3 className="text-[11px] font-bold text-outline uppercase tracking-wider mb-4">Identity Verification</h3>
                      <div className="space-y-4">
                        <div className="flex justify-between border-b border-border pb-2">
                          <span className="text-sm font-medium text-muted-foreground">Legal Name</span>
                          <span className="text-sm font-bold text-foreground">{name || "—"}</span>
                        </div>
                        <div className="flex justify-between border-b border-border pb-2">
                          <span className="text-sm font-medium text-muted-foreground">Authenticated Email</span>
                          <span className="text-sm font-bold text-foreground">{user?.email || "—"}</span>
                        </div>
                        <div className="flex justify-between border-b border-border pb-2">
                          <span className="text-sm font-medium text-muted-foreground">Declared Title</span>
                          <span className="text-sm font-bold text-foreground">{title || "—"}</span>
                        </div>
                      </div>
                    </div>
                    
                    <div>
                      <h3 className="text-[11px] font-bold text-outline uppercase tracking-wider mb-4">Proof Signals</h3>
                      <div className="space-y-4">
                        <div className="flex justify-between border-b border-border pb-2 items-center">
                          <span className="text-sm font-medium text-muted-foreground">Audit Status</span>
                          <ProofSignal type={verificationStatus === 'verified' ? 'verified' : verificationStatus === 'pending' ? 'pending' : 'declared'} label={verificationStatus.replace('_', ' ')} />
                        </div>
                        <div className="flex justify-between border-b border-border pb-2 items-center">
                          <span className="text-sm font-medium text-muted-foreground">Technical Stack</span>
                          <ProofSignal type={skills.length > 0 ? "declared" : "pending"} label={`${skills.length} listed`} />
                        </div>
                        <div className="flex justify-between border-b border-border pb-2 items-center">
                          <span className="text-sm font-medium text-muted-foreground">Verified by Assessment</span>
                          <ProofSignal type={assessmentCount > 0 ? "assessed" : "pending"} label={`${assessmentCount} complete`} />
                        </div>
                        <div className="flex justify-between border-b border-border pb-2 items-center">
                          <span className="text-sm font-medium text-muted-foreground">Project Evidence</span>
                          <ProofSignal type={projects.length > 0 ? "authenticated" : "pending"} label={`${projects.length} repos`} />
                        </div>
                      </div>
                    </div>
                  </div>
                </section>
              </div>
            )}

            {/* IDENTITY TAB */}
            {activeTab === "about" && (
              <div className="space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-300">
                <section>
                  <div className="flex justify-between items-end border-b border-border pb-2 mb-6">
                    <h2 className="text-xs font-bold text-foreground uppercase tracking-widest">Core Identity</h2>
                  </div>
                  
                  <div className="grid grid-cols-1 gap-6 sm:grid-cols-2">
                    <Input
                      label="Full Legal Name"
                      value={name}
                      onChange={(e) => setName(e.target.value)}
                      placeholder="e.g. Ada Lovelace"
                      disabled={isLocked}
                    />
                    <Input
                      label="Professional Title (Not persisted)"
                      value={title}
                      onChange={(e) => setTitle(e.target.value)}
                      placeholder="e.g. Senior Frontend Engineer"
                      disabled={isLocked}
                    />
                    <Input
                      label="Location (Not persisted)"
                      value={location}
                      onChange={(e) => setLocation(e.target.value)}
                      placeholder="e.g. San Francisco, CA"
                      disabled={isLocked}
                    />
                    <div className="relative">
                      <Input
                        label="GitHub URL"
                        type="url"
                        value={githubUrl}
                        onChange={(e) => setGithubUrl(e.target.value)}
                        placeholder="https://github.com/..."
                        disabled={isLocked}
                      />
                      {githubUrl && <ProofSignal type="declared" label="Provided" className="absolute right-0 top-0" />}
                    </div>
                  </div>
                  <div className="mt-6">
                    <Textarea
                      label="Professional Summary (Not persisted)"
                      value={summary}
                      onChange={(e) => setSummary(e.target.value)}
                      placeholder="Tell employers what you build and what kind of engineering work you specialize in."
                      rows={4}
                      disabled={isLocked}
                    />
                  </div>
                </section>
              </div>
            )}

            {/* EDUCATION TAB */}
            {activeTab === "education" && (
              <div className="space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-300">
                <section>
                  <div className="flex justify-between items-end border-b border-border pb-2 mb-6">
                    <h2 className="text-xs font-bold text-foreground uppercase tracking-widest">Academic Record</h2>
                    <ProofSignal type="declared" label="Self-Declared" />
                  </div>
                  <div className="grid grid-cols-1 gap-6 sm:grid-cols-2">
                    <div className="sm:col-span-2">
                      <label className="mb-1.5 block text-sm font-medium text-foreground">University / College</label>
                      <Autocomplete
                        value={college}
                        onChange={setCollege}
                        fetchOptions={fetchColleges}
                        placeholder="Search for your university..."
                        disabled={isLocked}
                      />
                    </div>
                    <div className="space-y-1.5">
                      <label className="block text-sm font-medium text-foreground">Engineering Branch</label>
                      <select
                        className="w-full rounded-sm border border-border bg-surface px-3 py-2 text-base sm:text-sm text-foreground focus:border-foreground focus:outline-none focus:ring-1 focus:ring-foreground disabled:cursor-not-allowed disabled:opacity-50"
                        value={branch}
                        onChange={(e) => setBranch(e.target.value)}
                        disabled={isLocked}
                      >
                        <option value="">Select Branch</option>
                        {ENGINEERING_BRANCHES.map((b) => (
                          <option key={b} value={b}>{b}</option>
                        ))}
                      </select>
                    </div>
                    <div className="grid grid-cols-2 gap-4">
                      <div className="space-y-1.5">
                        <label className="block text-sm font-medium text-foreground">Grad Year</label>
                        <select
                          className="w-full rounded-sm border border-border bg-surface px-3 py-2 text-base sm:text-sm text-foreground focus:border-foreground focus:outline-none focus:ring-1 focus:ring-foreground disabled:cursor-not-allowed disabled:opacity-50"
                          value={gradYear}
                          onChange={(e) => setGradYear(e.target.value)}
                          disabled={isLocked}
                        >
                          <option value="">Select Year</option>
                          {PASSING_YEARS.map((y) => (
                            <option key={y} value={y}>{y}</option>
                          ))}
                        </select>
                      </div>
                      <Input
                        label="CGPA (Not persisted)"
                        value={cgpa}
                        onChange={(e) => setCgpa(e.target.value)}
                        placeholder="e.g. 3.8"
                        disabled={isLocked}
                      />
                    </div>
                  </div>
                </section>
              </div>
            )}

            {/* SKILLS TAB */}
            {activeTab === "skills" && (
              <div className="space-y-10 animate-in fade-in slide-in-from-bottom-4 duration-300">
                <section>
                  <div className="flex justify-between items-end border-b border-border pb-2 mb-6">
                    <h2 className="text-xs font-bold text-foreground uppercase tracking-widest">Technical Stack</h2>
                  </div>
                  
                  {/* Verified Skills */}
                  {userProfile?.assessmentScores && Object.keys(userProfile.assessmentScores).length > 0 && (
                    <div className="mb-8">
                      <h3 className="text-[11px] font-bold text-outline uppercase tracking-wider mb-3">Verified Signals</h3>
                      <div className="flex flex-col gap-3">
                        {Object.keys(userProfile.assessmentScores).map(skill => (
                          <div key={skill} className="flex items-center justify-between border border-border p-3 bg-surface">
                            <span className="text-sm font-bold text-foreground">
                              {skill.replace('python_', 'Python (').replace('_', ' ')}{skill.startsWith('python_') ? ')' : ''}
                            </span>
                            <ProofSignal type="assessed" label="Verified" source="Proctored Assessment" />
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                  
                  {/* Declared Skills */}
                  <div>
                    <h3 className="text-[11px] font-bold text-outline uppercase tracking-wider mb-3 flex items-center justify-between">
                      Declared Stack <ProofSignal type="declared" label="Unverified" />
                    </h3>
                    <TagInput
                      tags={skills}
                      onChange={setSkills}
                      placeholder="Type a technology and press Enter..."
                      disabled={isLocked}
                    />
                  </div>
                </section>
              </div>
            )}

            {/* PROJECTS TAB */}
            {activeTab === "projects" && (
              <div className="space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-300">
                <section>
                  <div className="flex justify-between items-end border-b border-border pb-2 mb-6">
                    <h2 className="text-xs font-bold text-foreground uppercase tracking-widest">Project Evidence</h2>
                    {!isLocked && (
                      <Button variant="outline" size="xs" onClick={() => {
                        setProjects([...projects, { id: `p-${Date.now()}`, title: "", repoUrl: "", liveUrl: "", description: "" }]);
                      }}>
                        <Plus className="mr-1.5 h-3.5 w-3.5" /> Add Evidence
                      </Button>
                    )}
                  </div>

                  {projects.length === 0 ? (
                    <div className="border border-dashed border-border p-12 text-center bg-surface-low">
                      <h3 className="text-sm font-bold text-foreground">No evidence attached</h3>
                      <p className="mt-1 text-sm text-muted-foreground mb-4">Provide repositories of your best technical work for audit.</p>
                    </div>
                  ) : (
                    <div className="space-y-6">
                      {projects.map((project, index) => (
                        <div key={project.id} className="relative border border-border bg-surface p-6 shadow-[0_2px_8px_rgba(0,0,0,0.02)]">
                          <div className="absolute top-0 left-0 w-1 h-full bg-foreground opacity-20"></div>
                          
                          <div className="flex justify-between items-start mb-5 pb-3 border-b border-border">
                            <div>
                              <h3 className="text-[11px] font-bold text-outline uppercase tracking-wider mb-1">Evidence #{index + 1}</h3>
                              <ProofSignal type="declared" label="Pending Audit" source="Candidate Provided" />
                            </div>
                            {!isLocked && (
                              <button onClick={() => setProjects(projects.filter(p => p.id !== project.id))} className="text-outline hover:text-danger transition-colors flex items-center gap-1 text-[11px] font-bold uppercase tracking-wider">
                                <Trash2 className="h-3.5 w-3.5" /> Remove
                              </button>
                            )}
                          </div>

                          <div className="grid gap-5 sm:grid-cols-2">
                            <Input
                              label="Repository Name"
                              value={project.title}
                              onChange={(e) => {
                                const newP = [...projects];
                                newP[index].title = e.target.value;
                                setProjects(newP);
                              }}
                              placeholder="e.g. Distributed Key-Value Store"
                              disabled={isLocked}
                            />
                            <Input
                              label="Repository URL"
                              value={project.repoUrl}
                              onChange={(e) => {
                                const newP = [...projects];
                                newP[index].repoUrl = e.target.value;
                                setProjects(newP);
                              }}
                              placeholder="https://github.com/..."
                              disabled={isLocked}
                            />
                            <div className="sm:col-span-2">
                              <Input
                                label="Live Demo URL (Optional)"
                                value={project.liveUrl || ""}
                                onChange={(e) => {
                                  const newP = [...projects];
                                  newP[index].liveUrl = e.target.value;
                                  setProjects(newP);
                                }}
                                placeholder="https://..."
                                disabled={isLocked}
                              />
                            </div>
                            <div className="sm:col-span-2">
                              <Textarea
                                label="Technical Provenance (Description)"
                                value={project.description}
                                onChange={(e) => {
                                  const newP = [...projects];
                                  newP[index].description = e.target.value;
                                  setProjects(newP);
                                }}
                                placeholder="Explain the architecture, challenging problems solved, and technical decisions made."
                                rows={3}
                                disabled={isLocked}
                              />
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </section>
              </div>
            )}

            {/* EXPERIENCE TAB */}
            {activeTab === "experience" && (
              <div className="space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-300">
                <section>
                  <div className="flex justify-between items-end border-b border-border pb-2 mb-6">
                    <h2 className="text-xs font-bold text-foreground uppercase tracking-widest">Professional Experience</h2>
                    {!isLocked && (
                      <Button variant="outline" size="xs" onClick={() => {
                        setExperience([...experience, { id: `e-${Date.now()}`, role: "", company: "", startDate: "", endDate: "", description: "" }]);
                      }}>
                        <Plus className="mr-1.5 h-3.5 w-3.5" /> Add Entry
                      </Button>
                    )}
                  </div>
                  
                  {experience.length === 0 ? (
                    <div className="border border-dashed border-border p-12 text-center bg-surface-low">
                      <h3 className="text-sm font-bold text-foreground">No experience declared</h3>
                      <p className="mt-1 text-sm text-muted-foreground mb-4">Add your professional work history.</p>
                    </div>
                  ) : (
                    <div className="relative border-l border-border ml-3 space-y-8">
                      {experience.map((exp, index) => (
                        <div key={exp.id} className="relative pl-6">
                          <div className="absolute -left-[5px] top-1.5 h-2 w-2 rounded-full bg-foreground" />
                          <div className="bg-surface border border-border p-5 shadow-[0_2px_8px_rgba(0,0,0,0.02)]">
                            <div className="flex justify-between items-start mb-4">
                              <ProofSignal type="declared" label="Self-Declared" source="Unverified" />
                              {!isLocked && (
                                <button onClick={() => setExperience(experience.filter(e => e.id !== exp.id))} className="text-outline hover:text-danger transition-colors">
                                  <Trash2 className="h-4 w-4" />
                                </button>
                              )}
                            </div>
                            <div className="grid gap-5 sm:grid-cols-2">
                              <Input
                                label="Role / Title"
                                value={exp.role}
                                onChange={(e) => {
                                  const newE = [...experience];
                                  newE[index].role = e.target.value;
                                  setExperience(newE);
                                }}
                                disabled={isLocked}
                              />
                              <Input
                                label="Company"
                                value={exp.company}
                                onChange={(e) => {
                                  const newE = [...experience];
                                  newE[index].company = e.target.value;
                                  setExperience(newE);
                                }}
                                disabled={isLocked}
                              />
                              <Input
                                label="Start Date"
                                type="month"
                                value={exp.startDate}
                                onChange={(e) => {
                                  const newE = [...experience];
                                  newE[index].startDate = e.target.value;
                                  setExperience(newE);
                                }}
                                disabled={isLocked}
                              />
                              <Input
                                label="End Date"
                                type="month"
                                value={exp.endDate}
                                onChange={(e) => {
                                  const newE = [...experience];
                                  newE[index].endDate = e.target.value;
                                  setExperience(newE);
                                }}
                                placeholder="Leave empty if current"
                                disabled={isLocked}
                              />
                              <div className="sm:col-span-2">
                                <Textarea
                                  label="Description"
                                  value={exp.description}
                                  onChange={(e) => {
                                    const newE = [...experience];
                                    newE[index].description = e.target.value;
                                    setExperience(newE);
                                  }}
                                  rows={3}
                                  disabled={isLocked}
                                />
                              </div>
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </section>
              </div>
            )}

            {/* ASSESSMENTS TAB */}
            {activeTab === "assessments" && (
              <div className="space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-300">
                <section>
                  <div className="flex justify-between items-end border-b border-border pb-2 mb-6">
                    <h2 className="text-xs font-bold text-foreground uppercase tracking-widest">Assessment Signals</h2>
                  </div>
                  
                  {assessmentCount === 0 ? (
                    <div className="border border-dashed border-border p-12 text-center bg-surface-low">
                      <h3 className="text-sm font-bold text-foreground">No assessments taken</h3>
                      <p className="mt-1 text-sm text-muted-foreground mb-4">Complete proctored assessments to generate objective proof signals.</p>
                      <Button variant="outline" onClick={() => router.push("/candidate/assessment")}>
                        View Assessments
                      </Button>
                    </div>
                  ) : (
                    <div className="space-y-4">
                      {Object.entries(userProfile?.assessmentScores || {}).map(([skill, score]) => (
                        <div key={skill} className="flex flex-col sm:flex-row sm:items-center justify-between border border-border p-5 bg-surface shadow-[0_2px_8px_rgba(0,0,0,0.02)] gap-4">
                          <div>
                            <h3 className="text-base font-bold text-foreground">
                              {skill.replace('python_', 'Python (Variant ').replace('_', ' ').toUpperCase() + (skill.startsWith('python_') ? ')' : '')}
                            </h3>
                            <div className="mt-2">
                              <ProofSignal type="assessed" label="Completed" source="Proctored Engine" />
                            </div>
                          </div>
                          <div className="flex items-baseline gap-1 text-right bg-surface-low px-4 py-2 border border-border">
                            <span className="text-2xl font-black text-foreground">{score as React.ReactNode}</span>
                            <span className="text-sm font-medium text-muted-foreground">/ 5</span>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </section>
              </div>
            )}

          </div>
        </div>
      </div>
    </div>
  );
}
